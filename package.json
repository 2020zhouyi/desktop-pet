{
  "name": "desktop-pet-mvp",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "A minimal Electron desktop pet MVP inspired by Codex's pet renderer.",
  "author": "xianyu",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "test:pet-health": "node tests/pet-health.test.mjs",
    "test:package-health": "node tests/package-health.test.mjs",
    "test:package-verify": "node tests/package-verify.test.mjs",
    "test:window-security": "node tests/window-security.test.mjs",
    "test:window-geometry": "node tests/window-geometry.test.mjs",
    "test:window-surfaces": "node tests/window-surfaces.test.mjs",
    "test:windows-release": "node tests/windows-release.test.mjs",
    "test:ipc-capabilities": "node tests/ipc-capabilities.test.mjs",
    "test:picker-only-surface": "node tests/picker-only-surface.test.mjs",
    "test:picker-preview": "node --experimental-strip-types tests/behavior/picker-preview.test.ts",
    "test:pet-state-machine": "node --experimental-strip-types tests/behavior/slim-pet-state-machine.test.ts",
    "test:bubbles": "node --experimental-strip-types tests/behavior/slim-bubbles.test.ts",
    "test:selection-store": "node tests/behavior/pet-selection-store.test.mjs",
    "test:pet-library": "node tests/behavior/pet-library.test.mjs",
    "smoke:electron": "node tests/smoke/electron-smoke.mjs",
    "build": "tsc --noEmit && vite build",
    "preflight": "node scripts/preflight.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win",
    "preview": "vite preview --host 127.0.0.1",
    "pet:check": "node scripts/pet-health.mjs",
    "pet:embed-bubbles": "node --experimental-strip-types scripts/embed-pet-bubbles.ts",
    "package:check": "node scripts/package-check.mjs",
    "package:verify": "node scripts/package-verify.mjs"
  },
  "dependencies": {},
  "build": {
    "appId": "com.desktoppet.mvp",
    "productName": "Desktop Pet MVP",
    "asar": true,
    "extraResources": [
      {
        "from": "pets",
        "to": "pets-seed"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "wait-on": "^9.0.10"
  }
}
