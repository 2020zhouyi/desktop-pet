{
  "name": "desktop-pet-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "A minimal Electron desktop pet MVP inspired by Codex's pet renderer.",
  "author": "xianyu",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win",
    "preview": "vite preview --host 127.0.0.1",
    "pet:wave": "node scripts/pet-state.mjs waving",
    "pet:jump": "node scripts/pet-state.mjs jumping",
    "pet:run": "node scripts/pet-state.mjs running 1600",
    "pet:wait": "node scripts/pet-state.mjs waiting",
    "pet:review": "node scripts/pet-state.mjs review",
    "pet:fail": "node scripts/pet-state.mjs failed",
    "pet:idle": "node scripts/pet-state.mjs idle",
    "daily-status:validate": "node scripts/validate-daily-status.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "build": {
    "appId": "com.desktoppet.mvp",
    "productName": "Desktop Pet MVP",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "pets/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "wait-on": "^9.0.10"
  }
}
